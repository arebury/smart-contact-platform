{
  "name": "smart-contact-platform",
  "version": "0.1.0",
  "description": "Smart Contact monorepo — Supervisor app (AED + Memory features), ds-docs site, Smart Contact Design System (SCDS).",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve supervisor",
    "start:supervisor": "ng serve supervisor",
    "start:ds-docs": "ng serve ds-docs",
    "build": "ng build supervisor",
    "build:supervisor": "ng build supervisor",
    "build:ds-docs": "npm run tokens:export && ng build ds-docs",
    "build:all": "npm run tokens:export && ng build supervisor && ng build ds-docs",
    "watch": "ng build supervisor --watch --configuration development",
    "test": "CHROME_BIN=\"$(node -e 'console.log(require(\"@playwright/test\").chromium.executablePath())')\" ng test supervisor --watch=false --browsers=ChromeHeadless",
    "test:watch": "CHROME_BIN=\"$(node -e 'console.log(require(\"@playwright/test\").chromium.executablePath())')\" ng test supervisor --browsers=ChromeHeadless",
    "test:ci": "CHROME_BIN=\"$(node -e 'console.log(require(\"@playwright/test\").chromium.executablePath())')\" ng test supervisor --watch=false --browsers=ChromeHeadlessCI --code-coverage",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "lint": "ng lint supervisor",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "i18n:audit:strict": "node scripts/i18n-audit.mjs --strict",
    "tokens:export": "node scripts/export-sc-tokens.mjs",
    "tokens:parity": "node scripts/token-parity.mjs",
    "tokens:type-parity": "node scripts/token-type-parity.mjs",
    "tokens:gen": "node scripts/token-gen.mjs",
    "tokens:import": "node scripts/token-gen.mjs --write",
    "tokens:guard": "node scripts/token-guard.mjs",
    "tokens:audit": "node scripts/component-audit.mjs",
    "ds-docs:screenshots": "node scripts/gen-component-screenshots.mjs",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,html,scss,css,json}\"",
    "format:check": "prettier --check \"{apps,packages}/**/*.{ts,html,scss,css,json}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "{apps,packages}/**/*.{ts,html,scss,css,json}": "prettier --write"
  },
  "dependencies": {
    "@angular/animations": "^21.2.12",
    "@angular/cdk": "^21.2.10",
    "@angular/common": "^21.2.12",
    "@angular/compiler": "^21.2.12",
    "@angular/core": "^21.2.12",
    "@angular/forms": "^21.2.12",
    "@angular/platform-browser": "^21.2.12",
    "@angular/platform-browser-dynamic": "^21.2.12",
    "@angular/router": "^21.2.12",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "@primeng/themes": "^21.0.4",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.10",
    "@angular-eslint/builder": "^18.3.0",
    "@angular-eslint/eslint-plugin": "^18.3.0",
    "@angular-eslint/eslint-plugin-template": "^18.3.0",
    "@angular-eslint/schematics": "^18.3.0",
    "@angular-eslint/template-parser": "^18.3.0",
    "@angular/build": "^21.2.10",
    "@angular/cli": "^21.2.10",
    "@angular/compiler-cli": "^21.2.12",
    "@playwright/test": "^1.59.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.3.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}

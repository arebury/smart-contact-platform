{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git stash list*)",
      "Bash(git worktree list*)",
      "Bash(npm run lint*)",
      "Bash(npm run test*)",
      "Bash(npm run e2e*)",
      "Bash(npm run build*)",
      "Bash(npm run tokens:*)",
      "Bash(npm run i18n:audit*)",
      "Bash(npm run format:check*)",
      "Bash(npx tsc*)",
      "Bash(npx playwright*)",
      "Bash(npx prettier --check*)",
      "Bash(node scripts/*)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(grep*)",
      "Bash(rg*)",
      "Bash(find*)",
      "Bash(wc*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(git push --force*)"
    ]
  }
}
